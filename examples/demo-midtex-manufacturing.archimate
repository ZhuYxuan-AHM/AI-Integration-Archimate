<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.opengroup.org/xsd/archimate/3.0/"
    name="Midtex Manufacturing — AI Integration Model"
    id="model-demo-midtex-001"
    version="3.0">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    DEMO MODEL: Midtex Manufacturing Co. — Customer Service AI Integration
    ═══════════════════════════════════════════════════════════════════════

    Scenario:
      Mid-sized Malaysian manufacturing company integrating AI into the
      Customer Service department to handle product inquiries, complaints,
      and warranty claims. Demonstrates DSA theory (vertical SA breakdown
      between management and front-line workers) and ArchiMate 3.2
      modeling of AI integration constraints and responsibilities.

    Compliance status:
      Customer Service AI Bot → 5/5 checks PASS (C1–C5)

    Theory grounding:
      • Endsley (1995) SA levels: PA=3.8 / CA=2.1 / PrA=1.4
      • Stanton et al. (2006) DSA: vertical sharing = 31%
      • Principle 1: AI as Tool — not autonomous agent
      • Principle 2: Organization as Constraint — not a variable

    Generated by AI Integration Architecture Toolkit v1.0
    ═══════════════════════════════════════════════════════════════════════
  -->

  <elements>

    <!-- ══════════════════════════════════════════════════════════════════
         MOTIVATION LAYER
         ══════════════════════════════════════════════════════════════════ -->

    <element xsi:type="archimate:Stakeholder" id="el-stk-itdir" name="IT Director (Zhang Wei)">
      <documentation>Senior IT Director championing the AI adoption initiative. Responsible for technology strategy, vendor relationships, and reporting AI performance to the Board. Holds final authority on AI system architecture decisions.</documentation>
    </element>

    <element xsi:type="archimate:Stakeholder" id="el-stk-opsdir" name="Operations Director (Li Mei)">
      <documentation>Operations Director accountable for customer service KPIs including response time and CSAT. Approved the FY2025 AI budget (USD 30,000/year) and sets the strategic efficiency targets that drive the AI integration project.</documentation>
    </element>

    <element xsi:type="archimate:Stakeholder" id="el-stk-csmgr" name="CS Manager (Chen Fang)">
      <documentation>Customer Service Manager — primary operational sponsor. Manages 28 customer service representatives and is accountable for day-to-day AI system performance. Must sign off on all AI workflow changes affecting staff. Key interface between business operations and IT architecture.</documentation>
    </element>

    <element xsi:type="archimate:Driver" id="el-drv-efficiency" name="Operational Efficiency">
      <documentation>Business driver: reduce average customer inquiry first-response time from 8 minutes to under 4 minutes. Current staffing cannot meet demand peaks (Mon morning, post-holiday). AI-assisted routing and draft generation is the proposed solution.</documentation>
    </element>

    <element xsi:type="archimate:Driver" id="el-drv-cost" name="Cost Reduction">
      <documentation>Business driver: reduce per-ticket handling cost from RM 12.40 to under RM 8.00 through AI-assisted response drafting. Target: 35% cost reduction within 18 months of full deployment, without headcount reduction (staff redeployed to escalation handling).</documentation>
    </element>

    <element xsi:type="archimate:Driver" id="el-drv-resistance" name="Employee Resistance to AI">
      <documentation>Organizational risk driver: 67% of CS representatives surveyed (n=28) perceive AI as a job threat. Front-line staff have low comprehension of AI limitations and tend to either over-trust outputs (responsibility gap) or refuse to use the system (productivity gap). Requires change management alongside technical deployment.</documentation>
    </element>

    <element xsi:type="archimate:Goal" id="el-goal-response" name="Reduce Response Time 40%">
      <documentation>SMART Goal: Average first-response time reduced from 8.2 min to 4.9 min (40% reduction) within 6 months of AI deployment. Measured via CRM system timestamps. Owner: CS Manager (Chen Fang). Review: monthly Operations Director report.</documentation>
    </element>

    <element xsi:type="archimate:Goal" id="el-goal-csat" name="CSAT Score to 85%">
      <documentation>SMART Goal: Customer Satisfaction score improved from 72% to 85% within 12 months post-deployment. Measured via post-interaction SMS survey (currently 3,200 responses/month). Owner: Operations Director (Li Mei). Note: AI must maintain quality — speed without quality degrades CSAT.</documentation>
    </element>

    <element xsi:type="archimate:Goal" id="el-goal-compliance" name="PDPA Full Compliance">
      <documentation>Mandatory goal: Full compliance with Malaysia Personal Data Protection Act 2010 throughout AI deployment. Non-negotiable — any compliance gap triggers immediate system suspension. Owner: Compliance Officer (Wang Fang). Verified: third-party audit October 2025.</documentation>
    </element>

    <element xsi:type="archimate:Principle" id="el-pri-tool" name="Principle 1: AI as Tool">
      <documentation>DSR Core Principle (Hevner et al. 2004): AI systems are tools that augment human decision-making — they are not autonomous agents. ARCHITECTURAL IMPLICATION: «AI Application» elements may only be connected to Business Roles via UsedBy relationships. AI output always requires human review before customer-facing action. AI cannot be assigned to Business Processes as autonomous executor. Responsibility remains with the human role.</documentation>
    </element>

    <element xsi:type="archimate:Principle" id="el-pri-org" name="Principle 2: Organization as Constraint">
      <documentation>DSR Core Principle (Stanton et al. 2006): Organizational structures, responsibility chains, regulatory boundaries, and cultural norms are pre-existing constraints that define the design space — not variables to be optimized away. ARCHITECTURAL IMPLICATION: Architects must work within organizational constraints (see Constraint elements), not design solutions that require changing them. Path dependency is real. The organization shapes what AI CAN do, not the other way around.</documentation>
    </element>

    <element xsi:type="archimate:Assessment" id="el-assess-dsa" name="CS Dept DSA Assessment 2025">
      <documentation>Distributed Situation Awareness diagnostic assessment of the Customer Service department. Conducted August 2025 using mixed methods (SAGAT + structured interviews, n=42). Reveals critical VERTICAL DSA breakdown: management holds fundamentally different situational awareness about AI capabilities than front-line representatives. This breakdown is the primary failure mechanism explained by DSA theory.</documentation>
      <specialization name="AI Diagnostic Assessment"/>
      <properties>
        <!-- SA Score Profile (Endsley 1995) -->
        <property key="measurement_target" value="Customer Service Department — Managers (n=8) vs. Representatives (n=34)"/>
        <property key="pa_score" value="3.8"/>
        <property key="ca_score" value="2.1"/>
        <property key="pra_score" value="1.4"/>
        <property key="sample_size" value="42"/>
        <property key="measurement_date" value="2025-08-20"/>
        <property key="measurement_tool" value="SAGAT"/>
        <property key="interpretation" value="High perception (PA=3.8): staff CAN identify AI-generated outputs. Critical gap: comprehension (CA=2.1) is far below perception — staff cannot reliably evaluate accuracy of AI outputs or understand failure modes. Projection (PrA=1.4) is critically low: staff cannot anticipate when AI will fail. This creates a responsibility vacuum: staff accept AI outputs they cannot critically evaluate. Theory: Endsley Level 2-3 gap."/>
        <!-- DSA Score Profile (Stanton et al. 2006) -->
        <property key="breakdown_type" value="vertical (management vs. worker)"/>
        <property key="vertical_sharing_score" value="31%"/>
        <property key="horizontal_sharing_score" value="67%"/>
        <property key="temporal_consistency_score" value="54%"/>
        <property key="measurement_method" value="Mixed Methods"/>
      </properties>
    </element>

    <!-- ══════════════════════════════════════════════════════════════════
         BUSINESS LAYER
         ══════════════════════════════════════════════════════════════════ -->

    <element xsi:type="archimate:BusinessFunction" id="el-fn-cs" name="Customer Service Department">
      <documentation>Primary customer-facing department. Handles product inquiries (42%), complaints (35%), warranty claims (18%), and general feedback (5%) — approximately 4,800 tickets/month. Peak load: Monday morning and post-public-holiday periods. 28 representatives, 4 team leads, 1 manager.</documentation>
    </element>

    <element xsi:type="archimate:BusinessFunction" id="el-fn-it" name="IT Department">
      <documentation>Internal IT department responsible for infrastructure, system integration, AI vendor management, and deployment oversight. 12-person team. Owns the AI model evaluation and deployment process. Reports to IT Director.</documentation>
    </element>

    <element xsi:type="archimate:BusinessRole" id="el-role-csrep" name="Customer Service Representative">
      <documentation>Front-line role. Uses the AI system to receive response suggestions for customer inquiries. CRITICAL: Representative MUST review every AI-generated response before sending. Representative holds final accountability for customer communication content — this responsibility CANNOT be delegated to the AI system (Principle 1). Current SA profile: PA=3.8, CA=1.8 (below department average), PrA=1.2.</documentation>
    </element>

    <element xsi:type="archimate:BusinessRole" id="el-role-mgr" name="Department Manager">
      <documentation>CS Manager (Chen Fang). Oversees AI system adoption, monitors performance dashboards, chairs weekly AI review meetings, and escalates issues to Operations Director. Holds responsibility for department-level AI governance. SA profile: PA=4.1, CA=3.2, PrA=2.8 — significantly higher than representative average, explaining the vertical DSA breakdown.</documentation>
    </element>

    <element xsi:type="archimate:BusinessRole" id="el-role-itarch" name="IT Architect">
      <documentation>Zhang Wei — technical architect accountable for AI model selection process, system integration design, and maintaining the Responsibility Profile documentation. Leads the AI model evaluation process. Serves as technical interface between IT Department and CS Department during deployment.</documentation>
    </element>

    <element xsi:type="archimate:BusinessActor" id="el-actor-compliance" name="Compliance Officer (Wang Fang)">
      <documentation>Wang Fang — designated AI Compliance Officer. Responsible for regulatory sign-off on AI deployment, maintaining audit logs, liaising with external legal counsel (Azmi &amp; Associates), and annual compliance review. Reports to Operations Director. Named in Compliance Profile — required for C5 check.</documentation>
    </element>

    <element xsi:type="archimate:BusinessActor" id="el-actor-customer" name="Customer (External)">
      <documentation>External customer interacting with Midtex customer service. Receives AI-assisted (but human-reviewed) responses. Does not interact directly with AI system. Privacy rights protected under PDPA 2010.</documentation>
    </element>

    <element xsi:type="archimate:BusinessProcess" id="el-proc-complaint" name="Customer Complaint Resolution">
      <documentation>End-to-end process for handling customer complaints. Stage 1: AI classifies complaint type and severity. Stage 2: AI drafts initial response. Stage 3: Representative reviews, edits, and approves. Stage 4: Representative sends final response. Stage 5: System logs interaction (7-year retention). AI role is assistive — human makes final decision at stages 3-4.</documentation>
    </element>

    <element xsi:type="archimate:BusinessProcess" id="el-proc-evaluation" name="AI Model Evaluation Process">
      <documentation>Structured 3-month (June–August 2025) evaluation comparing 3 AI model candidates. Phases: (1) Test dataset preparation (500 anonymized historical tickets), (2) Blind A/B testing by 5 senior representatives, (3) Technical evaluation (latency, cost, API stability), (4) Compliance review, (5) Expert panel scoring, (6) Results presented to Operations Director for client selection decision.</documentation>
    </element>

    <!-- ══════════════════════════════════════════════════════════════════
         APPLICATION LAYER — AI APPLICATION (FULLY COMPLIANT)
         ══════════════════════════════════════════════════════════════════ -->

    <element xsi:type="archimate:ApplicationComponent" id="el-csbot" name="Customer Service AI Bot">
      <documentation>Primary AI application for customer service assistance at Midtex Manufacturing. Processes customer inquiries via natural language understanding, classifies ticket type and urgency, drafts contextually appropriate responses in English and Bahasa Malaysia, and routes escalations above confidence threshold. DEPLOYED VIA: Azure OpenAI (GPT-4o). STATUS: FULLY COMPLIANT — all 5 compliance checks pass. All 3 mandatory profiles complete.</documentation>
      <specialization name="AI Application"/>
      <properties>

        <!-- ── RESPONSIBILITY PROFILE (C1) ──────────────────────── -->
        <property key="selection_responsible" value="Zhang Wei (IT Architect)"/>
        <property key="selection_doc_link" value="sharepoint.midtex.com/ai-docs/csbot-selection-report-v2-2025.pdf"/>
        <property key="design_responsible" value="Zhang Wei (IT Architect) in collaboration with Chen Fang (CS Manager)"/>
        <property key="design_doc_link" value="sharepoint.midtex.com/ai-docs/csbot-workflow-design-v3.pdf"/>
        <property key="review_responsible" value="Chen Fang (CS Manager)"/>
        <property key="review_mechanism" value="Weekly Monday 9am performance review meeting (IT Architect + CS Manager). Real-time monitoring dashboard flags any AI response with confidence score below 0.75 for mandatory human override before sending. Monthly audit: random sample of 200 tickets reviewed by senior representative to track accuracy drift. Quarterly external audit by Azmi &amp; Associates."/>
        <property key="monitoring_responsible" value="Li Ming (IT Operations Lead)"/>
        <property key="monitoring_dashboard" value="http://internal.midtex.com/ai-monitor/csbot-dashboard"/>
        <property key="data_governance_responsible" value="Wang Fang (Compliance Officer)"/>
        <property key="data_governance_doc_link" value="sharepoint.midtex.com/compliance/data-handling-policy-ai-v3.pdf"/>

        <!-- ── MODEL EVALUATION PROFILE (C2, C3, C4) ────────────── -->
        <property key="candidate_models" value="GPT-4o, Claude-3-Sonnet, Gemini-1.5-Pro"/>
        <property key="evaluation_date" value="2025-09-15"/>
        <property key="evaluation_method" value="Blind A/B evaluation: 5 senior CS representatives scored AI responses without knowing which model generated each response (scale 1-5: accuracy, naturalness, appropriateness). Separate technical evaluation: latency under production load, API uptime SLA, data residency compliance. PDPA compliance verified by Azmi &amp; Associates legal team."/>
        <property key="evaluation_dimensions" value="Response accuracy, Bahasa Malaysia quality, Response latency (p95), Monthly API cost, PDPA/data residency compliance, API stability (30-day uptime)"/>
        <property key="test_scenarios" value="Product complaint — manufacturing defect (n=200); Technical inquiry — product specifications (n=180); Warranty claim — eligibility assessment (n=120)"/>
        <property key="accuracy_per_model" value="GPT-4o: 91.2%, Claude-3-Sonnet: 88.7%, Gemini-1.5-Pro: 84.3%"/>
        <property key="monthly_cost_per_model" value="GPT-4o: USD 2,180, Claude-3-Sonnet: USD 1,640, Gemini-1.5-Pro: USD 1,290"/>
        <property key="latency_per_model" value="GPT-4o: 480ms (p95), Claude-3-Sonnet: 650ms (p95), Gemini-1.5-Pro: 390ms (p95)"/>
        <property key="compliance_per_model" value="GPT-4o: PASS (Azure Southeast Asia region), Claude-3-Sonnet: PASS (AWS ap-southeast-1), Gemini-1.5-Pro: CONDITIONAL (Google data residency review pending — excluded)"/>
        <property key="client_selected_model" value="GPT-4o"/>
        <property key="client_selection_date" value="2025-10-01"/>

        <!-- ── AI COMPLIANCE PROFILE (C5) ───────────────────────── -->
        <property key="applicable_regulations" value="Malaysia Personal Data Protection Act 2010 (PDPA); ISO/IEC 42001:2023 AI Management Systems; Midtex Internal AI Governance Policy v2.1 (Oct 2025)"/>
        <property key="compliance_verification" value="External legal review by Azmi &amp; Associates (completed Oct 2025, ref: AA/AI/2025/147). Internal IT security audit (Sep 2025). Azure OpenAI Data Processing Agreement signed. Annual ISO 42001 surveillance audit scheduled Jan 2026."/>
        <property key="non_transferable_responsibilities" value="(1) Final customer communication decision — representative must approve before sending; (2) Complaint severity classification for legal escalation; (3) Any response involving product safety, personal injury, or liability claims; (4) Customer data access authorization and consent decisions; (5) Escalation decisions to management"/>
        <property key="data_localization_required" value="Yes"/>
        <property key="audit_log_retention" value="7 years (PDPA Section 10 + Midtex internal policy)"/>
        <property key="compliance_officer" value="Wang Fang"/>

        <!-- ── COST PROFILE ──────────────────────────────────────── -->
        <property key="currency" value="USD"/>
        <property key="monthly_cost" value="2180"/>
        <property key="per_call_cost" value="0.008"/>
        <property key="token_cost" value="0.03"/>
        <property key="billing_cycle" value="Monthly pay-per-use via Azure OpenAI (invoiced in USD, settled MYR at monthly rate)"/>
        <property key="estimated_annual_cost" value="26160"/>

      </properties>
    </element>

    <!-- ══════════════════════════════════════════════════════════════════
         APPLICATION LAYER — AI MODELS (3 CANDIDATES)
         ══════════════════════════════════════════════════════════════════ -->

    <element xsi:type="archimate:DataObject" id="el-gpt4o" name="GPT-4o">
      <documentation>OpenAI GPT-4o — SELECTED MODEL for production deployment. Highest accuracy in evaluation (91.2%). Full PDPA compliance via Azure Southeast Asia region (data residency confirmed). Best Bahasa Malaysia performance across test scenarios. Deployed via Microsoft Azure OpenAI Service under Midtex Enterprise Agreement.</documentation>
      <specialization name="AI Model"/>
      <properties>
        <property key="model_name" value="GPT-4o"/>
        <property key="provider" value="OpenAI (deployed via Microsoft Azure OpenAI Service)"/>
        <property key="model_type" value="LLM (Large Language Model)"/>
        <property key="parameter_count" value="Undisclosed (OpenAI proprietary — estimated &gt;100B)"/>
        <property key="context_window" value="128,000 tokens"/>
        <property key="training_cutoff" value="2024-04"/>
        <property key="api_endpoint" value="https://midtex-ai.openai.azure.com/openai/deployments/gpt-4o/chat/completions"/>
        <property key="version" value="gpt-4o-2024-05-13"/>
      </properties>
    </element>

    <element xsi:type="archimate:DataObject" id="el-claude" name="Claude-3-Sonnet">
      <documentation>Anthropic Claude-3-Sonnet — EVALUATED CANDIDATE. Second-best accuracy (88.7%) and PDPA compliant (AWS ap-southeast-1). Lower cost than GPT-4o (USD 1,640/month). Not selected due to marginally lower Bahasa Malaysia performance on warranty claim scenario (82.1% vs GPT-4o 89.4%) and higher latency under peak load. Remains viable fallback if GPT-4o pricing changes.</documentation>
      <specialization name="AI Model"/>
      <properties>
        <property key="model_name" value="Claude-3-Sonnet"/>
        <property key="provider" value="Anthropic"/>
        <property key="model_type" value="LLM (Large Language Model)"/>
        <property key="parameter_count" value="Undisclosed (Anthropic proprietary)"/>
        <property key="context_window" value="200,000 tokens"/>
        <property key="training_cutoff" value="2024-02"/>
        <property key="api_endpoint" value="https://api.anthropic.com/v1/messages"/>
        <property key="version" value="claude-3-sonnet-20240229"/>
      </properties>
    </element>

    <element xsi:type="archimate:DataObject" id="el-gemini" name="Gemini-1.5-Pro">
      <documentation>Google DeepMind Gemini-1.5-Pro — EVALUATED CANDIDATE. Lowest cost (USD 1,290/month) and best raw latency (390ms p95) but received CONDITIONAL compliance verdict: Google data residency for Malaysia customer data requires additional Data Processing Agreement review. Excluded from selection due to unresolved PDPA compliance. Largest context window (1M tokens) — suitable if document processing use case added in future.</documentation>
      <specialization name="AI Model"/>
      <properties>
        <property key="model_name" value="Gemini-1.5-Pro"/>
        <property key="provider" value="Google DeepMind"/>
        <property key="model_type" value="Multimodal"/>
        <property key="parameter_count" value="Undisclosed (Google proprietary)"/>
        <property key="context_window" value="1,000,000 tokens"/>
        <property key="training_cutoff" value="2024-05"/>
        <property key="api_endpoint" value="https://generativelanguage.googleapis.com/v1/models/gemini-1.5-pro:generateContent"/>
        <property key="version" value="gemini-1.5-pro-001"/>
      </properties>
    </element>

    <!-- ══════════════════════════════════════════════════════════════════
         CONSTRAINTS (Principle 2: Organization as Constraint)
         ══════════════════════════════════════════════════════════════════ -->

    <element xsi:type="archimate:Constraint" id="el-con-pdpa" name="PDPA 2010 — Data Localization">
      <documentation>HARD compliance boundary. Malaysia Personal Data Protection Act 2010 requires that all customer personal data processed by AI systems remains within Malaysian jurisdiction. This constraint eliminates any AI provider without Southeast Asia data residency. It is non-negotiable and immutable — architects must select infrastructure that satisfies it, not seek exemption from it.</documentation>
      <properties>
        <property key="boundary_type" value="compliance"/>
        <property key="source" value="Personal Data Protection Act 2010 (Malaysia), Sections 4, 6, 9, 10; PDPC Guidance on AI Data Processing (2024)"/>
        <property key="rigidity" value="hard (immutable — law / physics / signed contract)"/>
        <property key="design_space" value="Architect CAN: select AI providers with confirmed Malaysia/Southeast Asia data residency (Azure SEA, AWS ap-southeast-1); implement consent capture UI at session start; configure 7-year audit log retention; use pseudonymization for model fine-tuning. Architect CANNOT: route customer PII through non-compliant international servers; deploy without signed DPA; skip consent flow for any customer interaction."/>
        <property key="affected_layer" value="Application, Business"/>
        <property key="affected_elements" value="Customer Service AI Bot, GPT-4o, Claude-3-Sonnet, Gemini-1.5-Pro, Customer Complaint Resolution"/>
      </properties>
    </element>

    <element xsi:type="archimate:Constraint" id="el-con-itdept" name="IT Department Authority Boundary">
      <documentation>SOFT departmental boundary. IT Department has exclusive authority over technology vendor selection and system architecture decisions. However, any AI workflow changes affecting CS Department staff operations require CS Manager sign-off before implementation. This boundary prevents IT from unilaterally deploying systems that change how representatives work without operational buy-in.</documentation>
      <properties>
        <property key="boundary_type" value="department"/>
        <property key="source" value="Midtex Organizational Policy OPS-07 v2.3 (IT Governance Framework, revised Jan 2025)"/>
        <property key="rigidity" value="soft (negotiable — policy / culture / budget)"/>
        <property key="design_space" value="Architect CAN: propose any technically sound architecture within budget; recommend and evaluate vendors independently; design integration patterns without CS approval. Must obtain CS Manager (Chen Fang) written sign-off for: changes to representative workflow, new UI requirements, changes to escalation routing. Can negotiate pilot scope with Operations Director if CS Manager and IT Director agree."/>
        <property key="affected_layer" value="Business, Application"/>
        <property key="affected_elements" value="Customer Service AI Bot, Customer Service Manager, IT Architect, Customer Complaint Resolution"/>
      </properties>
    </element>

    <element xsi:type="archimate:Constraint" id="el-con-language" name="Bilingual Requirement (EN + BM)">
      <documentation>HARD technical boundary defined by customer service SLA. All customer-facing AI outputs must meet minimum quality thresholds in both English (EN) and Bahasa Malaysia (BM). The 85% BM accuracy threshold is contractually binding — falling below it triggers SLA penalty clauses. This constraint directly eliminated Gemini-1.5-Pro from selection (BM accuracy: 79.2% on warranty scenario).</documentation>
      <properties>
        <property key="boundary_type" value="technical"/>
        <property key="source" value="Customer Service SLA Agreement v4.2, Clause 7.3 (Language Quality Standards); confirmed in evaluation (Aug 2025)"/>
        <property key="rigidity" value="hard (immutable — law / physics / signed contract)"/>
        <property key="design_space" value="Architect CAN: select any model passing BM threshold (≥85% on standard test set); implement language detection pre-processing to route BM tickets to BM-optimized prompt templates; use BM-specific fine-tuning if base model is marginal. Cannot: deploy model below threshold; use English-only responses for BM-speaking customers; skip BM quality evaluation in model selection process."/>
        <property key="affected_layer" value="Application"/>
        <property key="affected_elements" value="Customer Service AI Bot, GPT-4o, Claude-3-Sonnet, Gemini-1.5-Pro"/>
      </properties>
    </element>

    <element xsi:type="archimate:Constraint" id="el-con-budget" name="Annual AI Budget USD 30K">
      <documentation>SOFT budget constraint. Operations Director approved USD 30,000 annual budget for AI operational costs (API fees, monitoring tooling, integration maintenance). Current GPT-4o deployment at USD 26,160/year is within budget with USD 3,840 buffer. Constraint can be renegotiated with ROI evidence — the 40% response time improvement goal provides the business case for budget increase if needed.</documentation>
      <properties>
        <property key="boundary_type" value="responsibility"/>
        <property key="source" value="FY2025 IT Budget Approval — Operations Director (Li Mei) sign-off, October 2025, ref: FIN/2025/AI/003"/>
        <property key="rigidity" value="soft (negotiable — policy / culture / budget)"/>
        <property key="design_space" value="Architect CAN: select any solution within USD 30K/year total cost; propose budget increase with documented ROI calculation; phase deployment to reduce Year 1 costs; negotiate enterprise pricing with shortlisted vendors. Current selection (GPT-4o via Azure) at USD 26,160/year leaves USD 3,840 buffer for monitoring tools. If usage exceeds projection, architect can present cost-vs-benefit analysis to Operations Director."/>
        <property key="affected_layer" value="Application"/>
        <property key="affected_elements" value="Customer Service AI Bot"/>
      </properties>
    </element>

  </elements>

  <!-- ══════════════════════════════════════════════════════════════════════
       RELATIONSHIPS
       ══════════════════════════════════════════════════════════════════════ -->
  <relationships>

    <!-- Principle 1: AI as Tool — UsedBy (not Assignment to Process) -->
    <relationship xsi:type="archimate:UsedByRelationship"    id="rel-01" source="el-csbot" target="el-role-csrep" name="used by"/>
    <relationship xsi:type="archimate:UsedByRelationship"    id="rel-02" source="el-csbot" target="el-role-mgr"   name="monitored by"/>

    <!-- AI App associated with evaluated AI Models -->
    <relationship xsi:type="archimate:AssociationRelationship" id="rel-03" source="el-csbot" target="el-gpt4o"  name="selected model"/>
    <relationship xsi:type="archimate:AssociationRelationship" id="rel-04" source="el-csbot" target="el-claude" name="evaluated candidate"/>
    <relationship xsi:type="archimate:AssociationRelationship" id="rel-05" source="el-csbot" target="el-gemini" name="evaluated candidate"/>

    <!-- Constraints influence AI Application (Principle 2) -->
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-06" source="el-con-pdpa"     target="el-csbot" name="constrains"/>
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-07" source="el-con-itdept"   target="el-csbot" name="governs"/>
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-08" source="el-con-language" target="el-csbot" name="constrains"/>
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-09" source="el-con-budget"   target="el-csbot" name="bounds"/>

    <!-- Constraints also constrain model selection -->
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-10" source="el-con-pdpa"     target="el-gemini" name="excluded (conditional)"/>
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-11" source="el-con-language" target="el-gemini" name="excluded (BM threshold)"/>

    <!-- Assessment evaluates AI Application -->
    <relationship xsi:type="archimate:AssociationRelationship" id="rel-12" source="el-assess-dsa" target="el-csbot"      name="diagnoses"/>
    <relationship xsi:type="archimate:AssociationRelationship" id="rel-13" source="el-assess-dsa" target="el-role-csrep" name="measures"/>

    <!-- Motivational chain: Driver → Goal -->
    <relationship xsi:type="archimate:InfluenceRelationship"  id="rel-14" source="el-drv-efficiency" target="el-goal-response"   name="drives"/>
